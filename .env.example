# Admin authentication (required only when enabling the admin console)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use a random secret with at least 32 characters.
SESSION_SECRET=

# Optional GitHub integration
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Optional Netlify Database connection
NETLIFY_DB_URL=
DATABASE_URL=

# Optional Google Gemini integration
GEMINI_API_KEY=

# Optional Supabase Storage integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-assets

# Runtime
PORT=3000
NODE_ENV=development
