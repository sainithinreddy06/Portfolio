{
  "name": "sai-nithin-reddy-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=portfolio-server.mjs",
    "start": "node portfolio-server.mjs --production",
    "preview": "vite preview",
    "clean": "rm -rf dist portfolio-server.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test tests/*.test.ts",
    "lighthouse": "npx --yes lighthouse@13.6.0 http://localhost:3000 --output=json --output-path=lighthouse-report.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/eslint-parser": "^8.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
